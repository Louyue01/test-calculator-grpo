+def _deterministic_session_priority(trajectory: dict, session_id: int) -> int:
+    """Give each deterministic TQ session a stable, collision-free request key."""
+    parts = (
+        (int(trajectory["validate"]), 1),
+        (int(trajectory["step"]), 15),
+        (int(trajectory["sample_index"]), 31),
+        (int(trajectory["rollout_n"]), 8),
+        (session_id, 8),
+    )
+    priority = 0
+    for part, bits in parts:
+        if not 0 <= part < (1 << bits):
+            raise ValueError("Deterministic trajectory index exceeds its bounded request-key field")
+        priority = (priority << bits) | part
+    return priority
 
 
